package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Temporary till we move the files in this directory
filegroup {
    name: "framework-crashrecovery-module-sources",
    srcs: [
        "java/**/*.aidl",
        "java/**/*.java",
    ],
    path: "java",
    visibility: [
        "//frameworks/base/packages/CrashRecovery/framework",
    ],
}

java_sdk_library {
    name: "framework-crashrecovery",
    srcs: [
        "java/**/*.aidl",
        "java/**/*.java",
    ],
    apex_available: [
        "com.android.crashrecovery",
    ],
    static_libs: ["android.crashrecovery.flags-aconfig-java"],
    libs: [
        "modules-utils-preconditions",
    ],
    permitted_packages: [
        "android.crashrecovery",
        "android.service.watchdog",
    ],
    defaults: ["framework-module-defaults"],
    min_sdk_version: "36",
    sdk_version: "module_current",
    impl_library_visibility: [
        "//cts:__subpackages__",
        "//frameworks/base/tests:__subpackages__",
        "//packages/modules/CrashRecovery:__subpackages__",
    ],
    jarjar_rules: "jarjar-rules.txt",
}
